# Phase 4 remote example (plan 08 Phase 4). GENERATED BUT NEVER LOADED in Phase 0-2.
# Only the Hippocampus MCP is reverse-proxied; Hindsight, PostgreSQL and the
# Control Plane are never exposed. Remote mode must be explicitly enabled.
#
# This file is a candidate artifact only. Loading it requires separate
# authorization per plan 01 §1.3.

services:
  hippocampus-mcp:
    environment:
      HIPPOCAMPUS_REMOTE_MODE: "false"      # must be flipped explicitly, with authorization
      HIPPOCAMPUS_TRUSTED_PROXY: "<exact-proxy-ip>"
    # No host port in remote mode: the reverse proxy reaches it over the
    # internal network only.
    ports: []

  caddy:
    image: caddy@sha256:<digest>
    networks: [hippocampus-backend, edge]
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
    ports:
      - "443:443"
    # TLS is mandatory for Phase 4; the Phase 1-2 LAN HTTP exception does not
    # carry over (plan 04 §4.6).

networks:
  edge:
    driver: bridge
