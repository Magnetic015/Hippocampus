# Non-secret fixed Hindsight settings (plan 06 §6.5).
# Mounted as the hindsight service env_file. NEVER put secrets here.
HINDSIGHT_API_STORE_DOCUMENT_TEXT=false
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false
HINDSIGHT_API_WORKER_ID=pi5-hindsight-main
HINDSIGHT_API_MCP_ENABLED=false
HINDSIGHT_ENABLE_API=true
# Control Plane UI, enabled 2026-08-09. It is published on the LAN with no
# authentication of its own — accepted residual risk, see DEPLOYMENT.md §13.
HINDSIGHT_ENABLE_CP=true
HINDSIGHT_API_LLM_TRACE_ENABLED=false
HINDSIGHT_API_OTEL_TRACES_ENABLED=false
HINDSIGHT_API_LLM_DEBUG_DUMP_4XX=false
HINDSIGHT_API_AUDIT_LOG_ENABLED=false
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=Chinese
HINDSIGHT_API_TEXT_SEARCH_EXTENSION_NATIVE_LANGUAGE=simple
HINDSIGHT_API_QUERY_ANALYZER_LANGUAGES=en,zh

# Retain members admission-tested against the live cliproxy on 2026-08-08.
# Primary gpt-5.6-terra: chat + json_object + json_schema probes pass, real
# retain extraction ~13s.
# (The original plan candidates gemini-3-flash / deepseek-v4-flash did not
# survive admission — see reports/phase1-pi5-deployment.md §3.1.)
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-5.6-terra
HINDSIGHT_API_LLM_1_PROVIDER=openai
# Was gemini-3.6-flash until 2026-08-09, when it started returning 403 "billing
# not enabled" on the live cliproxy — plain chat included, so the failover backup
# was simply dead. gemini-3.5-flash fails the same way; gemini-3-flash-agent and
# gemini-3.1-flash-lite still work, so this is those two aliases' upstream
# project, not gemini as a whole. Re-pointed at an admitted member.
HINDSIGHT_API_LLM_1_MODEL=gpt-5.6-sol
HINDSIGHT_API_LLM_STRATEGY={"mode":"failover"}
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=16000

# Reflect chain (plan 06 §6.5; Phase 3 authorisation granted 2026-08-09).
# Reflect is an agentic tool loop, so admission tests tool-calling on top of the
# usual chat/json_schema probes. Admitted on the live cliproxy 2026-08-09:
# gpt-5.5 (primary) and gpt-5.6-sol (backup) both pass tool-calling and
# json_schema and are served under their own model id; takeover verified for
# real by pointing the primary at a nonexistent model. Rejected: glm-5.2 (the
# other plan candidate — absent from cliproxy), gemini-3.5/3.6-flash (403
# billing),
# deepseek-v4-pro (json_schema unsupported), claude-5.5/claude-5.6 (silently
# rerouted to gpt-5.5/gpt-5.6-sol, so they buy no vendor diversity). No
# cross-vendor backup exists on this cliproxy — see DEPLOYMENT.md §13.
# The primary inherits api_key/base_url from the global LLM; the indexed member
# inherits nothing, so its base_url/key are mapped in compose.yaml.
HINDSIGHT_API_REFLECT_LLM_PROVIDER=openai
HINDSIGHT_API_REFLECT_LLM_MODEL=gpt-5.5
HINDSIGHT_API_REFLECT_LLM_1_PROVIDER=openai
HINDSIGHT_API_REFLECT_LLM_1_MODEL=gpt-5.6-sol
HINDSIGHT_API_REFLECT_LLM_STRATEGY={"mode":"failover"}

HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
HINDSIGHT_API_RERANKER_1_PROVIDER=rrf
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=80
