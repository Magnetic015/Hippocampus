# Secret plane template (plan 04 §4.4). Real file lives at
# /home/kkp/.config/hippocampus/hippocampus.env with 0700 dir / 0600 file.
# Generate each value independently; NO value may be reused across variables.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# This example must never contain real values.

HIPPOCAMPUS_MODE=commissioning

HIPPOCAMPUS_DB_PASSWORD=<REDACTED-256bit-urlsafe>
HINDSIGHT_INTERNAL_TOKEN=<REDACTED-256bit-urlsafe>
HIPPOCAMPUS_TOKEN_PEPPER=<REDACTED-256bit-urlsafe>
HIPPOCAMPUS_AUDIT_HMAC_KEY=<REDACTED-256bit-urlsafe>
HIPPOCAMPUS_IDEMPOTENCY_HMAC_KEY=<REDACTED-256bit-urlsafe>

# Full OpenAI-compatible base URL: http|https, exactly one /v1, no userinfo,
# no query/fragment, no trailing slash. Code must not append /v1 again.
CLIPROXY_OPENAI_BASE_URL=https://cliproxy.example.internal/v1
CLIPROXY_KEY=<REDACTED>

# Pinned image digests (plan 06 §6.4), filled in after Phase 0 verification.
PGVECTOR_DIGEST=<sha256-hex>
HINDSIGHT_DIGEST=<sha256-hex>
HIPPOCAMPUS_MCP_DIGEST=<sha256-hex>

# Numeric kkp UID/GID read from the Pi5 in Phase 1 step 2.
KKP_UID=<uid>
KKP_GID=<gid>
